{
  "name": "casa-hebra",
  "version": "2.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "start:prod": "npm run start:prod -w server",
    "check": "npm run check -w server && npm run check -w client",
    "test": "npm run test -w server",
    "test:pure": "npm run test:pure -w server",
    "test:integration": "npm run test:integration -w server"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "qs": "6.16.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
